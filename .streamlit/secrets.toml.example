# ==============================================================================
# Streamlit Secrets Configuration Template
# ==============================================================================
# For local execution: Copy this file to '.streamlit/secrets.toml'
# For Streamlit Community Cloud: Paste these keys into 'Settings > Secrets'
#
# NOTE: '.streamlit/secrets.toml' contains sensitive credentials and is strictly
# excluded from Git tracking via .gitignore. Never commit live secrets.
# ==============================================================================

[database]
# Default local SQLite database (matches src/dashboard/database.py)
url = "sqlite:///compliance.db"

# Optional: Production PostgreSQL connection string for enterprise deployments
# url = "postgresql://compliance_user:strong_password@db.example.internal:5432/compliance_monitoring"

[azure]
# Optional: Azure Service Principal credentials for live cloud baseline collection (Step 2)
# tenant_id = "00000000-0000-0000-0000-000000000000"
# client_id = "00000000-0000-0000-0000-000000000000"
# client_secret = "your-service-principal-secret-key-here"
# subscription_id = "00000000-0000-0000-0000-000000000000"

[general]
# Deployment environment indicator: 'local', 'staging', 'production'
environment = "development"
